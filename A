nombres=[]
cant=0
while True:
    nom=input("Ingrese su nombre: ")
    nombres.append(nom)
    cant+=1
    try:
        opc=int(input("Desea agregar mas nombres? \n1)SI\n2)NO\n"))
    except ValueError:
        print("Dato invalido")
    else:
        if opc==2:
            break

nombres.sort()
ordenados=sorted(nombres,key=len)
print(f"La cantidad de nombres ingresados fueron: {cant}")
print(f"El nombre mas corto fue: {ordenados[0]} ")
print(f"El nombre mas largo fue: {ordenados[-1]} ")